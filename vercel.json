{
  "installCommand": "npm exec -y pnpm@11.19.0 install --frozen-lockfile && cd web && npm exec -y pnpm@11.19.0 install --frozen-lockfile",
  "buildCommand": "cd web && npm exec -y pnpm@11.19.0 test && npm exec -y pnpm@11.19.0 build",
  "outputDirectory": "web/dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "timelinevisualizer.app" }],
      "destination": "https://www.timelinevisualizer.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
