{
  "name": "Timeline Visualizer",
  "short_name": "Timeline",
  "description": "Create a private travel animation from a Google Maps Timeline export.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#fafbfc",
  "theme_color": "#0f172a",
  "categories": ["utilities", "travel"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./apple-touch-icon.svg",
      "sizes": "180x180",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
