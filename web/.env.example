# Optional: Cloudflare Web Analytics token (privacy-friendly, aggregate page views only)
# Get yours at: https://dash.cloudflare.com → Web Analytics
# VITE_CF_BEACON_TOKEN=your-token-here

# Set to false to disable Adsterra Native Banner script injection in production builds
# VITE_ADSTERRA_NATIVE=false

# Enable Waffo payment gate for MP4 download and share ($2.59 USD)
# VITE_PAYMENT_ENABLED=true

# CARTO basemap API key (required since 2025 — free at https://carto.com/basemaps/apikey/)
# VITE_CARTO_API_KEY=your-key-here
